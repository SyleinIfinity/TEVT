@model IEnumerable<QLBH_WEB_ADMIN.Models.SanPhamViewModel>
@{
    ViewBag.Title = "Danh sách sản phẩm";
    var apiBaseUrl = System.Configuration.ConfigurationManager.AppSettings["ApiBaseUrl"];
}

<h2>Danh sách sản phẩm</h2>

<p>
    @Html.ActionLink("Tạo mới", "Create")
</p>
<table class="table">
    <tr>
        <th>@Html.DisplayNameFor(model => model.TENSANPHAM)</th>
        <th>@Html.DisplayNameFor(model => model.DONGIA)</th>
        <th>@Html.DisplayNameFor(model => model.SOLUONG)</th>
        <th>@Html.DisplayNameFor(model => model.HINHANH)</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.TENSANPHAM)</td>
            <td>@Html.DisplayFor(modelItem => item.DONGIA)</td>
            <td>@Html.DisplayFor(modelItem => item.SOLUONG)</td>
            <td>
                @if (!string.IsNullOrEmpty(item.HINHANH))
                {
                    <img src="@(apiBaseUrl)/api/image/get/@item.HINHANH"
                         width="100"
                         class="img-thumbnail"
                         alt="@item.TENSANPHAM" />
                }
            </td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = item.MASANPHAM }) |
                @Html.ActionLink("Chi tiết", "Details", new { id = item.MASANPHAM }) |

                @using (Html.BeginForm("Delete", "QuanLySanPham", new { id = item.MASANPHAM }, FormMethod.Post, new { @style = "display:inline;" }))
                {
                    @Html.AntiForgeryToken()

                    <input type="submit" value="Xóa" class="btn btn-link"
                           style="padding:0; margin:0; border:none; color:#007bff; text-decoration:underline; cursor:pointer;"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');" />
                }
            </td>
        </tr>
    }
</table>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}